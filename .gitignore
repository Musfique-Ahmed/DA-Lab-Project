# ----- OS junk -----
.DS_Store
Thumbs.db
desktop.ini

# ----- Editors / IDEs -----
.vscode/
.idea/
*.swp
*.swo
*~

# ----- Node (none in this repo today, but harmless) -----
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ----- puku CLI state (embeddings + config) -----
.puku/

# ----- Local build scaffolding & QA scripts (not part of the deliverable) -----
build/

# ----- Local build output (PowerPoint deck drafts) -----
output/

# ----- Personal drafts -----
Presentation_Script.docx

# ----- Any temporary verification scripts we drop in the repo root -----
.verify.js
.extract.js
_extracted.js

# ----- Logs ----
*.log


.home-credit-default-risk/

# ----- Local virtual environment (Phase 1+) -----
.venv/
venv/

# ----- Python bytecode / caches -----
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# ----- Processed data and model artifacts (regenerable from source) -----
data/processed/*.parquet
data/processed/*.npz
data/processed/*.csv
# Raw dataset is gitignored — DVC tracks it via data/raw/application_train.csv.dvc
data/raw/application_train.csv
data/raw/application_train.csv.tmp
# Generated evaluation plots (regenerated by `dvc repro`)
reports/evaluation/*.png
# Trained model artifacts (regenerated by `dvc repro`)
models/*.pkl
models/*.joblib
models/*.h5
models/*.keras
models/*.pt

# MLflow local tracking + artifact store (regenerated by `python src/deploy_mlflow.py`)
mlruns/


# ----- DVC state — never commit the cache or local config -----
.dvc/cache/
.dvc/tmp/
.dvc/state
.dvc/lock
.dvc/config.local
.dvc/updater/

# ----- Local DVC remote storage (created by `dvc remote add`) -----
.dvc_remote/

# ----- Package metadata -----
*.egg-info/

# ----- Stray pip install artifacts (created when running `py -m pip install`
#       in the repo root without a venv) -----
Lib/
Scripts/
pyvenv.cfg
