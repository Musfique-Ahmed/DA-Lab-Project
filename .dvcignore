# DVC ignore rules — files that should not be tracked by DVC even if
# they live under a directory DVC is otherwise watching.
#
# This file mirrors .gitignore for the data layer; it prevents DVC from
# trying to import .gitkeep files, the .dvc pointer for the raw dataset,
# and other auxiliary artefacts that should stay out of the DVC cache.

# Empty placeholders
*.gitkeep
.gitkeep

# DVC's own bookkeeping
.dvc/tmp/
.dvc/cache/
.dvc/state
.dvc/lock
.dvc/config.local
.dvc/updater/

# Raw dataset .dvc pointer is generated by `dvc add` — do not re-track
data/raw/*.dvc.tmp
